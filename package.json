{
  "name": "saas-community-platform",
  "version": "1.0.0",
  "description": "SaaS WhatsApp/Telegram message distribution platform",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "npm run dev:setup && concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:setup": "tsx scripts/migrate.ts --seed",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "npm run dev --prefix \"./frontend\"",
    "dev:worker": "tsx watch src/worker.ts",
    "start:server": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:seed": "tsx scripts/migrate.ts --seed",
    "migrate:rollback": "npx knex migrate:rollback",
    "seed": "npx knex seed:run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx scripts/test-run.ts",
    "test:e2e:rule": "tsx scripts/test-run.ts --rule",
    "test:e2e:cleanup": "tsx scripts/test-run.ts --cleanup",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:status": "pm2 list"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@hapi/boom": "^10.0.1",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@whiskeysockets/baileys": "^6.7.16",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.42.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
